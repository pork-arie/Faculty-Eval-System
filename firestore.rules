rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ------------------------------------------------------------------
    // OWN-RECORD WRITES
    //
    // The password a person types is the `password` field on their roster
    // record - that is the credential both clients check on every sign-in.
    // So a person must be able to write that one field on their OWN record
    // when they change their password, and clear their own forceReset flag.
    // Everything else on students/teachers stays admin-only.
    // ------------------------------------------------------------------
    // The local part is the person's ID. It may carry a ".r2" suffix: when a
    // legacy Auth account is locked (a password nobody remembers, which no
    // client can reset), the app provisions a second account at <id>.r2 and
    // uses that from then on. Strip the suffix so that person can still change
    // their own password. IDs never contain a dot, so this is unambiguous.
    function ownsRecord(rec) {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.split('@')[0].split('\\.')[0]
           == (rec.sid is string ? rec.sid.lower() : rec.tid.lower());
    }
    function changesOwnPasswordOnly() {
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['forceReset', 'password', 'uid'])
        && request.resource.data.password is string
        && request.resource.data.sid == resource.data.sid
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid'])
            || request.resource.data.uid == request.auth.uid);
    }
    function changesOwnTeacherPasswordOnly() {
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['forceReset', 'password', 'uid'])
        && request.resource.data.password is string
        && request.resource.data.tid == resource.data.tid
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid'])
            || request.resource.data.uid == request.auth.uid);
    }

    match /admins/{uid} {
      allow read:  if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /questionSets/{doc}      { allow read: if signedIn(); allow write: if isAdmin(); }
    match /customDepartments/{doc} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /customCourses/{doc}     { allow read: if signedIn(); allow write: if isAdmin(); }
    match /departments/{doc}       { allow read: if signedIn(); allow write: if isAdmin(); }
    match /courses/{doc}           { allow read: if signedIn(); allow write: if isAdmin(); }
    match /schoolYears/{doc}       { allow read: if signedIn(); allow write: if isAdmin(); }
    match /settings/{doc}          { allow read: if signedIn(); allow write: if isAdmin(); }
    match /subjects/{doc}          { allow read: if signedIn(); allow write: if isAdmin(); }

    match /students/{doc} {
      allow read:           if signedIn();
      allow create, delete: if isAdmin();
      allow update:         if isAdmin()
                            || (ownsRecord(resource.data) && changesOwnPasswordOnly());
    }
    match /teachers/{doc} {
      allow read:           if signedIn();
      allow create, delete: if isAdmin();
      allow update:         if isAdmin()
                            || (ownsRecord(resource.data) && changesOwnTeacherPasswordOnly());
    }

    // ------------------------------------------------------------------
    // OWNING AN EVALUATION WITHOUT MATCHING evaluatorUid
    //
    // Evaluations are keyed by evaluatorUid, which is fine until the person's
    // Auth account is REPLACED - which is what the .r2 fallback does when a
    // legacy login is locked. The new account has a new uid, so their own past
    // submissions become unreadable to them and every finished subject reads
    // "Pending" again.
    //
    // The roster record is the stable identity: claimUid writes the current uid
    // onto students/{id} (or teachers/{id}) at every login. So a person owns an
    // evaluation when the roster document it points at carries THEIR uid, even
    // if the evaluation itself still carries an older one. That lets both
    // clients silently repoint their own records at sign-in, with no admin step.
    //
    // exists() guards the get(): a lookup on a deleted roster document would
    // otherwise error and deny the whole rule.
    function rosterUidFor(id, isSupervisor) {
      return isSupervisor
        ? (exists(/databases/$(database)/documents/teachers/$(id))
            ? get(/databases/$(database)/documents/teachers/$(id)).data.get('uid', '') : '')
        : (exists(/databases/$(database)/documents/students/$(id))
            ? get(/databases/$(database)/documents/students/$(id)).data.get('uid', '') : '');
    }
    function ownsEvaluation(rec) {
      return signedIn()
        && rec.studentId is string
        && rec.studentId != ''
        && rosterUidFor(rec.studentId, rec.evaluatorType == 'supervisor')
           == request.auth.uid;
    }

    match /evaluations/{doc} {
      allow read:   if isAdmin()
                    || resource.data.evaluatorUid == request.auth.uid
                    || ownsEvaluation(resource.data);
      allow create: if signedIn()
                    && request.resource.data.evaluatorUid == request.auth.uid;
      // Both clients build a DETERMINISTIC document id, so a second submission
      // for the same subject/term is an UPDATE, not a create. A student or
      // supervisor may overwrite only their own record, and only if it stays
      // theirs afterwards.
      allow update: if isAdmin()
                    || (signedIn()
                        && resource.data.evaluatorUid == request.auth.uid
                        && request.resource.data.evaluatorUid == request.auth.uid)
                    // Re-pointing an own record onto the current uid. Nothing
                    // else may change in the same write, so this cannot be used
                    // to alter a rating or move a record to someone else.
                    || (ownsEvaluation(resource.data)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['evaluatorUid'])
                        && request.resource.data.evaluatorUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /finalReports/{doc}      { allow read: if signedIn(); allow write: if isAdmin(); }
    match /developmentPlans/{doc}  { allow read, write: if isAdmin(); }
    match /exemptions/{doc}        { allow read, write: if isAdmin(); }

    match /auditLog/{doc} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // create is open because the entries that matter most have no signed-in
    // user behind them: a FAILED login. Append-only so nobody rewrites history.
    match /loginLogs/{doc} {
      allow read:   if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}