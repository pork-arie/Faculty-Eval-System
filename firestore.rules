rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function signedInId() {
      return request.auth.token.email.split('@')[0].split('\\.')[0];
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Whether the signed-in person owns this roster record.
    //
    // This used to be ONE function for both collections:
    //     rec.sid is string ? rec.sid.lower() : rec.tid.lower()
    // Teacher records have no `sid` field at all, and in rules reading a
    // field that does not exist is an ERROR, not null - so for every teacher
    // the whole check failed and a supervisor could never update their own
    // record. That is the "no permission" on the forced password change.
    // get() with a default reads a missing field safely.
    function ownsRecord(rec) {                       // students
      return signedIn()
        && request.auth.token.email is string
        && signedInId() == rec.get('sid', '').lower();
    }
    function ownsTeacherRecord(rec) {                // teachers / supervisors
      return signedIn()
        && request.auth.token.email is string
        && signedInId() == rec.get('tid', '').lower();
    }
    function changesOwnPasswordOnly() {
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['forceReset', 'password', 'uid'])
        && request.resource.data.password is string
        && request.resource.data.sid == resource.data.sid
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid'])
            || request.resource.data.uid == request.auth.uid);
    }
    function changesOwnTeacherPasswordOnly() {
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['forceReset', 'password', 'uid'])
        && request.resource.data.password is string
        && request.resource.data.tid == resource.data.tid
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid'])
            || request.resource.data.uid == request.auth.uid);
    }

    match /admins/{uid} {
      allow read:  if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /questionSets/{doc}      { allow read: if signedIn(); allow write: if isAdmin(); }
    match /customDepartments/{doc} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /customCourses/{doc}     { allow read: if signedIn(); allow write: if isAdmin(); }
    match /departments/{doc}       { allow read: if signedIn(); allow write: if isAdmin(); }
    match /deletedDepts/{doc}      { allow read: if signedIn(); allow write: if isAdmin(); }
    match /courses/{doc}           { allow read: if signedIn(); allow write: if isAdmin(); }
    match /schoolYears/{doc}       { allow read: if signedIn(); allow write: if isAdmin(); }
    match /settings/{doc}          { allow read: if signedIn(); allow write: if isAdmin(); }
    match /subjects/{doc}          { allow read: if signedIn(); allow write: if isAdmin(); }

    match /students/{doc} {
      allow read:           if isAdmin()
                            || (signedIn()
                                && request.auth.token.email is string
                                && resource.data.sid == signedInId());
      allow create, delete: if isAdmin();
      allow update:         if isAdmin()
                            || (ownsRecord(resource.data) && changesOwnPasswordOnly());
    }
    match /teachers/{doc} {
      allow read:           if signedIn();
      allow create, delete: if isAdmin();
      allow update:         if isAdmin()
                            || (ownsTeacherRecord(resource.data) && changesOwnTeacherPasswordOnly());
    }

    function rosterUidFor(id, isSupervisor) {
      return isSupervisor
        ? (exists(/databases/$(database)/documents/teachers/$(id))
            ? get(/databases/$(database)/documents/teachers/$(id)).data.get('uid', '') : '')
        : (exists(/databases/$(database)/documents/students/$(id))
            ? get(/databases/$(database)/documents/students/$(id)).data.get('uid', '') : '');
    }
    function ownsEvaluation(rec) {
      return signedIn()
        && rec.studentId is string
        && rec.studentId != ''
        && rosterUidFor(rec.studentId, rec.evaluatorType == 'supervisor')
           == request.auth.uid;
    }

    match /evaluations/{doc} {
      allow read:   if isAdmin()
                    || resource.data.evaluatorUid == request.auth.uid
                    || ownsEvaluation(resource.data);
      allow create: if signedIn()
                    && request.resource.data.evaluatorUid == request.auth.uid;
      allow update: if isAdmin()
                    || (signedIn()
                        && resource.data.evaluatorUid == request.auth.uid
                        && request.resource.data.evaluatorUid == request.auth.uid)
                    || (ownsEvaluation(resource.data)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['evaluatorUid'])
                        && request.resource.data.evaluatorUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /finalReports/{doc}      { allow read: if signedIn(); allow write: if isAdmin(); }
    match /developmentPlans/{doc}  { allow read, write: if isAdmin(); }
    match /exemptions/{doc}        { allow read, write: if isAdmin(); }

    match /auditLog/{doc} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Login trail. Failed logins come from people who are NOT signed in yet,
    // so create must stay open - but every entry is validated:
    //  - only the expected fields, with types and size limits (no junk/flooding
    //    with huge documents);
    //  - serverTime must be the server's clock (request.time), so the time of
    //    an entry cannot be faked;
    //  - a SUCCESSFUL login can only be written by that signed-in user about
    //    themselves, so nobody can forge "X logged in".
    function validLoginLog(d) {
      return d.keys().hasOnly(['username', 'success', 'timestamp', 'userAgent', 'loginType', 'serverTime'])
        && d.username is string && d.username.size() > 0 && d.username.size() <= 100
        && d.success is bool
        && d.timestamp is string && d.timestamp.size() <= 40
        && d.get('userAgent', '') is string && d.get('userAgent', '').size() <= 500
        && d.get('loginType', '') is string && d.get('loginType', '').size() <= 30
        && d.serverTime == request.time;
    }
    function isOwnLogin(d) {
      return signedIn()
        && request.auth.token.email is string
        && (d.username.lower() == signedInId()
            || d.username.lower() == request.auth.token.email.lower());
    }
    match /loginLogs/{doc} {
      allow read:   if isAdmin();
      allow create: if validLoginLog(request.resource.data)
                    && (request.resource.data.success == false
                        || isOwnLogin(request.resource.data));
      allow update, delete: if false;
    }

    // System monitoring: important user actions (e.g. Evaluation Submitted).
    // Anyone signed in may append an entry about themselves; only admins read.
    // An "Evaluation Submitted" entry is only accepted if that evaluation
    // really exists and was submitted by the same signed-in user, so the
    // entry cannot be faked. serverTime must be the server's clock.
    function realEvaluationBy(evalId, uid) {
      return exists(/databases/$(database)/documents/evaluations/$(evalId))
        && get(/databases/$(database)/documents/evaluations/$(evalId)).data.get('evaluatorUid', '') == uid;
    }
    match /activityLogs/{doc} {
      allow read:   if isAdmin();
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(
                         ['type', 'detail', 'userId', 'role', 'uid', 'userAgent', 'timestamp', 'evalId', 'serverTime'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.type == 'Evaluation Submitted'
                    && request.resource.data.timestamp is string
                    && request.resource.data.serverTime == request.time
                    && request.resource.data.get('detail', '') is string
                    && request.resource.data.get('detail', '').size() <= 300
                    && request.resource.data.get('userId', '') is string
                    && request.resource.data.get('userId', '').size() <= 60
                    && request.resource.data.get('role', '') is string
                    && request.resource.data.get('role', '').size() <= 20
                    && request.resource.data.get('userAgent', '') is string
                    && request.resource.data.get('userAgent', '').size() <= 500
                    && request.resource.data.evalId is string
                    && realEvaluationBy(request.resource.data.evalId, request.auth.uid);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}